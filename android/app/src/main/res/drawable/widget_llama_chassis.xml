<?xml version="1.0" encoding="utf-8"?>
<!-- LLAMA widget chassis: navy/blue-gray base with a restrained 1dp bevel (light top/left, dark bottom/right).
     Corners follow the launcher's widget radius like the standard background (app_widget_background). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="?attr/appWidgetRadius" />
      <solid android:color="@color/widget_llama_edge_dark" />
    </shape>
  </item>
  <item android:bottom="1dp" android:right="1dp">
    <shape android:shape="rectangle">
      <corners android:radius="?attr/appWidgetRadius" />
      <solid android:color="@color/widget_llama_edge_light_35" />
    </shape>
  </item>
  <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
    <shape android:shape="rectangle">
      <corners android:radius="?attr/appWidgetRadius" />
      <solid android:color="@color/widget_llama_base" />
    </shape>
  </item>
</layer-list>
