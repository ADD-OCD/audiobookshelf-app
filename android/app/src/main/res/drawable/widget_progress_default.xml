<?xml version="1.0" encoding="utf-8"?>
<!-- Snapshot progress bar for the standard widget look (track and played colors from widget_colors.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:id="@android:id/background">
    <shape android:shape="rectangle">
      <corners android:radius="2dp" />
      <solid android:color="@color/widget_default_track" />
    </shape>
  </item>
  <item android:id="@android:id/progress">
    <clip>
      <shape android:shape="rectangle">
        <corners android:radius="2dp" />
        <solid android:color="@color/widget_default_played" />
      </shape>
    </clip>
  </item>
</layer-list>
