<?xml version="1.0" encoding="utf-8"?>
<!-- LLAMA widget snapshot progress: amber played section in a recessed dark track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:id="@android:id/background">
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <corners android:radius="3dp" />
          <solid android:color="@color/widget_llama_edge_dark" />
        </shape>
      </item>
      <item android:top="1dp">
        <shape android:shape="rectangle">
          <corners android:radius="3dp" />
          <solid android:color="@color/widget_llama_track" />
        </shape>
      </item>
    </layer-list>
  </item>
  <item android:id="@android:id/progress" android:top="1dp">
    <clip>
      <shape android:shape="rectangle">
        <corners android:radius="3dp" />
        <solid android:color="@color/widget_llama_played" />
      </shape>
    </clip>
  </item>
</layer-list>
