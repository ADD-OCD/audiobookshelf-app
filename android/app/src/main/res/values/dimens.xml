    <dimen name="widget_margin">0dp</dimen>

    <!-- FULL widget artwork cap used only until the launcher reports the widget size; after that the renderer sets
         responsive bounds (widget/FullArtwork.kt). Just above a normal two-row FULL cover (~137dp), so that size
         is unchanged either way. -->
    <dimen name="widget_full_artwork_max">140dp</dimen>

    <!-- LARGE FULL: the floating brand icon's inset from the widget's top and end edges (inside launcher corner rounding) -->
    <dimen name="widget_large_icon_inset">10dp</dimen>

</resources>